{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header"><div class="container-fluid"><div class="pull-right">
    <button type="submit" form="form-wa-cross-sell" class="btn btn-primary">{{ button_save|escape }}</button>
    <a href="{{ cancel|replace({'&amp;':'&'})|escape }}" class="btn btn-default">{{ button_cancel|replace({'&amp;':'&'})|escape }}</a>
  </div><h1>{{ heading_title|escape }}</h1></div></div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger" role="alert">{{ error_warning|escape }}</div>{% endif %}
    <div class="panel panel-default"><div class="panel-heading"><h2 class="panel-title">{{ text_edit|escape }}</h2></div>
      <div class="panel-body"><p>{{ text_help|escape }}</p><p><a href="{{ products_url|replace({'&amp;':'&'})|escape }}" target="_blank" rel="noopener">{{ text_products|escape }}</a></p>
      <form action="{{ action|replace({'&amp;':'&'})|escape }}" method="post" id="form-wa-cross-sell" class="form-horizontal">
        {% for key in ['name','title','source_id','product_ids','limit','width','height'] %}
        <div class="form-group"><label class="col-sm-3 control-label" for="wa-{{ key }}">{{ attribute(_context, 'entry_' ~ key)|escape }}</label>
          <div class="col-sm-9"><input required type="text" name="{{ key }}" id="wa-{{ key }}" value="{{ attribute(_context, key)|escape }}" class="form-control" {% if key == 'name' %}maxlength="64"{% elseif key == 'title' %}maxlength="100"{% elseif key == 'product_ids' %}maxlength="500"{% else %}inputmode="numeric" maxlength="9"{% endif %}></div></div>
        {% endfor %}
        <div class="form-group"><label class="col-sm-3 control-label" for="wa-status">{{ entry_status|escape }}</label><div class="col-sm-9"><select name="status" id="wa-status" class="form-control"><option value="1" {% if status %}selected{% endif %}>{{ text_enabled|escape }}</option><option value="0" {% if not status %}selected{% endif %}>{{ text_disabled|escape }}</option></select></div></div>
      </form></div>
    </div>
  </div>
</div>{{ footer }}
